# API key for the Gemini provider (Google Gen AI SDK)
GEMINI_API_KEY=

# Model to use for LLM calls (structured output supported)
# Free-tier limits depend on the model; see Google's per-model rate-limit page.
GEMINI_MODEL=gemini-2.5-flash

# Minimum delay (ms) enforced between consecutive Gemini calls so TraceOS stays
# under your project's free-tier requests-per-minute cap. Default 13000ms is
# safe for a 5 RPM cap (~4.6 req/min). Raise it if you still see 429s, or lower
# it if Google shows you a higher limit.
#GEMINI_RATE_INTERVAL_MS=13000

# Eval cache: when a case's trajectory already exists under evidence/trajectories,
# the eval runner reuses it instead of calling Gemini again (no API quota used).
# Set to false to always re-run. You can also bypass on the CLI with `--force`.
#EVAL_USE_CACHE=true
