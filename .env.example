# ============================================================
# TraceOS is provider-independent. Set at least ONE provider key.
# Router order (when AI_PROVIDER=auto): Groq -> OpenRouter -> Gemini.
# ============================================================

# --- Groq (primary, OpenAI-compatible) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Free model catalogs change; set a current, structured-output-capable model.
GROQ_MODEL=

# --- OpenRouter (fallback, OpenAI-compatible) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# e.g. "meta-llama/llama-3.3-70b-instruct:free" (check current availability)
OPENROUTER_MODEL=

# --- Gemini (third fallback) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Router behavior ---
# "auto" (default) = try every provider that has a key, in priority order
#                    Groq -> OpenRouter -> Gemini.
# Or set an explicit comma-separated order, e.g. "openrouter,groq,gemini".
#AI_PROVIDER=auto
# When true (default), a failing provider (429 / network / bad output) falls
# back to the next one. Set to false to only ever use the first provider.
#AI_FALLBACK=true

# --- Rate limiting (applies to every provider) ---
# Minimum delay (ms) between consecutive LLM calls to stay under free-tier RPM.
# Default 13000ms is safe for a 5 RPM cap. Raise it if you still see 429s.
#GEMINI_RATE_INTERVAL_MS=13000

# --- Eval cache ---
# When a case's trajectory already exists under evidence/trajectories, the eval
# runner reuses it instead of calling the LLM again (no API quota used).
# Set to false to always re-run. You can also bypass on the CLI with `--force`.
#EVAL_USE_CACHE=true
