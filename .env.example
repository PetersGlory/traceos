# ============================================================
# TraceOS is provider-independent. Set at least ONE provider key.
# Router order (when AI_PROVIDER=auto): Groq -> OpenRouter -> Gemini.
# ============================================================

# --- Groq (primary, OpenAI-compatible) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Free model catalogs change; set a current, structured-output-capable model.
GROQ_MODEL=

# --- OpenRouter (fallback, OpenAI-compatible) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# e.g. "meta-llama/llama-3.2-3b-instruct:free" (check current availability)
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# --- Gemini (third fallback) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Router behavior ---
# "auto" (default) = try every provider that has a key, in priority order
#                    Groq -> OpenRouter -> Gemini.
# Or set an explicit comma-separated order, e.g. "openrouter,groq,gemini".
#AI_PROVIDER=auto
# When true (default), a failing provider (429 / network / bad output) falls
# back to the next one. Set to false to only ever use the first provider.
#AI_FALLBACK=true

# --- Rate limiting (per provider, applies to every provider) ---
# Minimum delay (ms) between consecutive LLM calls to a provider.
#   RATE_INTERVAL_MS_GROQ / _OPENROUTER / _GEMINI   per-provider override
#   RATE_INTERVAL_MS                               global fallback
#   GEMINI_RATE_INTERVAL_MS                        legacy alias for gemini
# Defaults are fast (1.5-5s). Raise only if you actually see 429s from a provider.
#RATE_INTERVAL_MS_GROQ=2000
#RATE_INTERVAL_MS_OPENROUTER=1500
#RATE_INTERVAL_MS_GEMINI=5000

# --- Eval cache ---
# When a case's trajectory already exists under evidence/trajectories, the eval
# runner reuses it instead of calling the LLM again (no API quota used).
# Set to false to always re-run. You can also bypass on the CLI with `--force`.
#EVAL_USE_CACHE=true
